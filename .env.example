# Copie este arquivo para .env e troque os valores.
# O .env NUNCA e versionado (ver .gitignore).

# ---------- Banco de dados (desenvolvimento, via Docker) ----------
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=crm_dev
MYSQL_USER=crm
MYSQL_PASSWORD=troque_esta_senha

# Usada pelo Prisma. Precisa bater com as variaveis acima.
# Use 127.0.0.1, nao localhost: em alguns ambientes Windows o localhost
# resolve para IPv6 e a conexao com o container falha.
DATABASE_URL="mysql://crm:troque_esta_senha@127.0.0.1:3306/crm_dev"
# Banco dos testes de integracao. SEPARADO do de desenvolvimento: os
# testes truncam as tabelas entre casos.
TEST_DATABASE_URL="mysql://crm:troque_esta_senha@127.0.0.1:3306/crm_test"


# Opcional, so para "npm run db:drift" (compara as migrations com o banco).
# O nome do banco tem de casar com o padrao prisma_migrate_shadow_db%, o
# unico que o usuario de desenvolvimento pode criar. Ver docker/mysql/init.
SHADOW_DATABASE_URL="mysql://crm:troque_esta_senha@127.0.0.1:3306/prisma_migrate_shadow_db_diff"

# ---------- API (NestJS) ----------
API_PORT=3333
# Onde o site responde ao publico. A API usa nos links de e-mail; o site, nos
# enderecos absolutos de canonico, Open Graph e JSON-LD da vitrine (C7). Em
# producao, o dominio real com https — senao a previa do link aponta para ca.
WEB_ORIGIN=http://localhost:3000

# ---------- Web (Next.js) ----------
# O site chama a API por caminho relativo (/api), via rewrite do Next.
# Nao ha mais URL absoluta com porta: isso voltaria a ser requisicao
# entre origens e exigiria CORS.

# Nome visivel do produto. Mantido em um unico lugar porque a marca
# ainda nao esta decidida (ver docs/architecture.md).
NEXT_PUBLIC_APP_NAME=Doverni

# ---------- E-mail ----------
# Adaptador de envio. Hoje o unico valor aceito e "log", que escreve o
# e-mail no terminal em vez de enviar — serve para trabalhar nos fluxos de
# convite, verificacao e recuperacao sem provedor contratado.
#
# ATENCAO: "log" e RECUSADO em producao, na inicializacao da API. O corpo
# carrega o token em claro, e log e copiado, agregado e lido por mais gente
# do que a caixa de entrada da pessoa. O provedor real ainda nao foi
# escolhido (ver docs/roadmap.md).
EMAIL_PROVIDER=log

# Nome do produto nos e-mails. Se ausente, usa NEXT_PUBLIC_APP_NAME.
# APP_NAME=Doverni

# Validade dos tokens de uso unico, em segundos.
# Padroes: convite 7 dias, verificacao de e-mail 24h, redefinicao 1h.
# Nao sao iguais de proposito: quanto maior o estrago de um token vazado,
# menor a janela.
# VALIDADE_DO_CONVITE=604800
# VALIDADE_DA_VERIFICACAO=86400
# VALIDADE_DA_REDEFINICAO=3600

# ---------- Midia (fotos e documentos do imovel) ----------
# Adaptador de armazenamento. Hoje o unico valor aceito e "local", que grava
# no disco e serve os arquivos pela propria API, com URL assinada.
#
# ATENCAO: "local" e RECUSADO em producao, na inicializacao. O destino de
# producao e o Cloudflare R2 (decidido em 21/10/2026, ver
# docs/architecture.md); o adaptador dele entra quando as credenciais
# existirem. Servir foto pelo processo da API gastaria a CPU e a banda do
# plano compartilhado — o motivo pelo qual o R2 foi escolhido.
MIDIA_PROVIDER=local

# Onde o adaptador local grava. Relativo a raiz do monorepo, fora do Git.
MIDIA_DIR=.midia-dev

# Segredo que assina as URLs de upload e de leitura do adaptador local.
# A assinatura E a autorizacao de escrita: sem segredo proprio, qualquer
# pessoa que leia o codigo forjaria uma URL de envio.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MIDIA_SIGN_SECRET=troque_por_32_caracteres_ou_mais_aleatorios

# Base publica da API, para montar as URLs assinadas. Em desenvolvimento e o
# site, porque o Next repassa /api/* para a API.
# API_PUBLIC_URL=http://localhost:3000

# ---------- Autenticacao ----------
# Segredo do HMAC usado para hashear IP antes de guardar (LGPD).
# ATENCAO: sha256 puro de IP NAO anonimiza — o espaco IPv4 inteiro se
# forca-bruta em minutos. O segredo e o que torna o hash irreversivel.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor torna os hashes antigos incomparaveis com os novos.
IP_HASH_SECRET=troque_por_32_caracteres_ou_mais_aleatorios

# Custo do Argon2id. Os padroes sao a linha de base da OWASP.
# CALIBRE NO SERVIDOR REAL, nao no notebook: suba ate o hash levar entre
# 100ms e 500ms em producao.
# ARGON2_MEMORY_COST=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# Duracoes da sessao, em segundos. Padroes: 12h, 30 dias, 7 dias.
# SESSAO_DURACAO_ABSOLUTA=43200
# SESSAO_DURACAO_PROLONGADA=2592000
# SESSAO_DURACAO_INATIVIDADE=604800

# Saltos de proxy confiaveis para ler o IP real do cliente.
# Conferir contra a hospedagem na Fase 4.
# TRUST_PROXY_HOPS=1

# Para onde o Next repassa /api/*. Em desenvolvimento, a API local.
# API_INTERNAL_URL=http://127.0.0.1:3333

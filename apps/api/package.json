{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-config-datasource --exit-code",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p test/tsconfig.json && tsc -p prisma/tsconfig.json --noEmit",
    "db:seed": "tsc -p prisma/tsconfig.json && node dist-seed/prisma/seed.js"
  },
  "dependencies": {
    "@app/shared": "0.1.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.9",
    "@nestjs/schematics": "12.0.9",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  }
}
